# ==============================================================================
# LANGFUSE CONFIGURATION (Data Bridge with Agent Repo — Port 3000)
# ==============================================================================
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# ==============================================================================
# AGENT PRODUCTION / STAGING ENDPOINTS (Port 8080 HTTP / Port 50051 gRPC)
# ==============================================================================
AGENT_API_URL=http://localhost:8080
AGENT_GRPC_HOST=localhost:50051

# ==============================================================================
# JUDGE LLM CONFIGURATION (Separate from Agent Model to avoid Sycophancy Bias)
# ==============================================================================
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_MODEL=gpt-4o-mini
JUDGE_LLM_API_KEY=dummy-key
JUDGE_LLM_BASE_URL=http://localhost:20128/v1

# ==============================================================================
# PROMETHEUS PUSHGATEWAY & EVAL API PORTS (Safe Ports — Avoid Agent Collisions)
# ==============================================================================
# Safe ports: 9091 (Pushgateway), 8088 (Eval API), 8089 (Worker Health), 3002 (Standalone Grafana)
PUSHGATEWAY_URL=http://localhost:9091
EVAL_API_HOST=0.0.0.0
EVAL_API_PORT=8088
EVAL_WORKER_HEALTH_PORT=8089

# ==============================================================================
# HUMAN-IN-THE-LOOP (HITL) NOTIFICATIONS
# ==============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/X000
HITL_REVIEW_BASE_URL=http://localhost:3000/project/default/traces

# ==============================================================================
# EXPERIMENT & A/B TESTING DEFAULTS
# ==============================================================================
DEFAULT_EXPERIMENT_NAME=model_comparison_v1
SAMPLE_RATE=0.10
